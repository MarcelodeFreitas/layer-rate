{
  "name": "layer-rate-cli",
  "version": "0.1.0",
  "description": "Command-line interface for the LayerRate 3D print pricing engine.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "layer-rate": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "3d-printing",
    "pricing",
    "quotes",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "layer-rate-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
